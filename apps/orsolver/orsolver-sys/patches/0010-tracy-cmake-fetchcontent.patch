diff --git i/CMakeLists.txt w/CMakeLists.txt
index 69bf10b..828982d 100644
--- i/CMakeLists.txt
+++ w/CMakeLists.txt
@@ -444,6 +444,31 @@ include(host)
 # verify deps
 include(check_deps)
 
+
+# orsolver Tracy profiling: fetch Tracy and link it into all OR-Tools targets.
+# Activated by passing -DORSOLVER_TRACY=1 to cmake (done by orsolver-sys/build.rs
+# for debug builds). TRACY_ON_DEMAND means the process runs normally until the
+# Tracy profiler app connects — no startup blocking.
+if(DEFINED ORSOLVER_TRACY)
+  include(FetchContent)
+  set(TRACY_ENABLE ON CACHE BOOL "" FORCE)
+  set(TRACY_ON_DEMAND ON CACHE BOOL "" FORCE)
+  FetchContent_Declare(
+    tracy
+    GIT_REPOSITORY https://github.com/wolfpld/tracy.git
+    GIT_TAG v0.11.1
+    GIT_SHALLOW TRUE
+  )
+  FetchContent_MakeAvailable(tracy)
+  # Link Tracy into every target built after this point.
+  link_libraries(Tracy::TracyClient)
+  # Add to the install export so cmake export validation is satisfied.
+  install(TARGETS TracyClient
+    EXPORT ortoolsTargets
+    ARCHIVE DESTINATION ${CMAKE_INSTALL_LIBDIR}
+  )
+endif()
+
 include(cpp)
 include(flatzinc)
 include(glop)
