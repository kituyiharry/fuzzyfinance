# Drizzle
DATABASE_URL=file:local.db

ORIGIN=""

# Better Auth
# For production use 32 characters and generated with high entropy
# https://www.better-auth.com/docs/installation
BETTER_AUTH_SECRET=""

# Google OAuth — used for both login and the Google Workspace integration
# The same credentials work for both; Drive/Sheets scopes are requested
# separately during the integrations flow.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Microsoft 365 integration
# Register an app at https://portal.azure.com → App registrations
# Required redirect URI: {ORIGIN}/api/integrations/microsoft/callback
# Required API permission: Microsoft Graph → Files.ReadWrite (delegated)
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""

# Gemini AI — used for receipt data extraction
# Get a key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=""

# Optional: override the maximum receipt file upload size in bytes (default 10 MB)
# MAX_RECEIPT_FILE_SIZE_BYTES=10485760

# Cloudflare R2, Vectorize, and Workers AI are configured via wrangler.jsonc bindings.
# Run these commands once to provision the resources:
#   wrangler r2 bucket create fuzzyfinance-receipts
#   wrangler vectorize create receipts-index --dimensions=768 --metric=cosine
