{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "fuzzyfinance",
	"compatibility_date": "2026-04-01",
	"compatibility_flags": [
		"nodejs_als"
	],
	"main": "./worker-entry.js",
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	"workers_dev": true,
	"preview_urls": true,
	"observability": {
		"enabled": true,
		"head_sampling_rate": 1,
		"logs": {
			"enabled": true,
			"head_sampling_rate": 1,
			"persist": true,
			"invocation_logs": true
		},
		"traces": {
			"enabled": false,
			"persist": true,
			"head_sampling_rate": 1
		}
	},
	"vars": {
		"ORIGIN": "https://fuzzies.app",
		"MICROSOFT_CLIENT_ID": "",
		"MICROSOFT_CLIENT_SECRET": "",
	},
	// Cron Trigger — daily R2 cleanup at 03:00 UTC
	// Deletes R2 objects for synced docs (7d TTL) and abandoned uploads (30d TTL)
	"triggers": {
		"crons": [
			"0 3 * * *"
		]
	},
	// Cloudflare D1 — primary database
	// Create with: wrangler d1 create fuzzyfinance-db
	// Then replace database_id below with the returned ID
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "fuzzyfinance-db",
			//"database_id": "REPLACE_WITH_D1_DATABASE_ID",
			"database_id": "c4c82b8c-79b9-4901-a2bb-18716e423ec2",
			"migrations_dir": "drizzle/migrations"
		}
		// {
		//     "d1_databases": [
		//         {
		//             "binding": "fuzzyfinance_db",
		//             "database_name": "fuzzyfinance-db",
		//             "database_id": "c4c82b8c-79b9-4901-a2bb-18716e423ec2"
		//         }
		//     ]
		// }
	],
	// Cloudflare R2 — transit buffer for uploaded receipt/sale files
	// Create with: wrangler r2 bucket create fuzzyfinance-receipts
	"r2_buckets": [
		{
			"bucket_name": "fuzzyfinance-receipts",
			"binding": "fuzzyfinance_receipts",
			//"preview_bucket_name": "fuzzyfinance-receipts-preview"
			"preview_bucket_name": "fuzzyfinance-receipts"
		}
	],
	// Workers AI — used for text embedding (bge-base-en-v1.5, 768 dims)
	"ai": {
		"binding": "AI"
	},
	// Cloudflare Vectorize — semantic search index
	// Create with: wrangler vectorize create receipts-index --dimensions=768 --metric=cosine
	"vectorize": [
		// {
		// 	"binding": "VECTORIZE",
		// 	"index_name": "receipts-index"
		// },
		{
			"binding": "VECTORIZE",
			"index_name": "receipts-index",
			"remote": true
		}
	]
}
